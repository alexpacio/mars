# MARS disk_name is mars/RESOURCE; sysfs escapes the slash as '!'.
# devtmpfs creates /dev/mars/RESOURCE. No external chmod helper is needed.
SUBSYSTEM=="block", KERNEL=="mars!*", MODE="0600", GROUP="disk"
# Retain the match for historical kernels exposing the unescaped name.
SUBSYSTEM=="block", KERNEL=="mars/*", MODE="0600", GROUP="disk"
