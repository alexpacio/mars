#!/usr/bin/make -f
include /usr/share/dpkg/default.mk

%:
	dh $@

override_dh_install:
	python3 scripts/stage-source.py debian/mars-dkms/usr/src/mars-$(DEB_VERSION_UPSTREAM) --version $(DEB_VERSION_UPSTREAM)
	dh_install

override_dh_dkms:
	dh_dkms -V $(DEB_VERSION_UPSTREAM)

# Cluster creation and module loading are explicit administrator operations.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start --name=mars

override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_install:
override_dh_auto_clean:

override_dh_auto_test:
	python3 -m unittest discover -s test_suite/build -v
