#
# Makefile for MARS
#

# Keep the kernel's compiler hardening and optimization policy.
# External builds use checked Kconfig defaults; in-tree builds use Kconfig.
ifneq ($(KBUILD_EXTMOD),)
CONFIG_MARS := m
always-y += mars_config.h
GEN_CONFIG_SCRIPT := $(src)/../scripts/gen_config.pl
$(obj)/mars_config.h: $(src)/Kconfig $(GEN_CONFIG_SCRIPT) FORCE
	$(Q)$(kecho) "  GEN     $@"
	$(Q)set -e; trap 'rm -f "$@.tmp"' EXIT; \
	    perl $(GEN_CONFIG_SCRIPT) --kernel-config $(objtree)/.config < $(src)/Kconfig > $@.tmp; \
	    if ! cmp -s $@.tmp $@; then mv $@.tmp $@; fi
endif

obj-$(CONFIG_MARS)	+= mars.o

CFLAGS_mars_trace.o += -I$(src)

mars-objs := mars_trace.o\
	compat.o				\
	lamport.o			\
	brick_say.o			\
	brick_mem.o			\
	brick.o				\
	mars_generic.o			\
	lib_log.o			\
	lib_rank.o			\
	lib_limiter.o			\
	lib_timing.o			\
	lib_mapfree.o			\
	mars_net.o			\
	mars_server.o			\
	mars_client.o			\
	mars_aio.o			\
	mars_sio.o			\
	mars_bio.o			\
	mars_if.o			\
	mars_copy.o			\
	mars_trans_logger.o		\
	sy_old/sy_generic.o		\
	sy_old/sy_net.o			\
	sy_old/mars_proc.o		\
	sy_old/mars_main.o

ifdef CONFIG_DEBUG_KERNEL

ccflags-y += $(call cc-option,-fno-inline-functions)

# This is currently not really used.
# We urge people to maintain it by including it in debug versions
# (so the compiler may throw any complaints)

mars-objs += 				\
	mars_dummy.o			\
	mars_check.o			\
	mars_buf.o			\
	mars_usebuf.o			\

endif

# Re-evaluate metadata and environment overrides every build, but replace
# headers only if their contents changed (preserving incremental builds).
export MARSVERSION
ifneq ($(strip $(SOURCE_DATE_EPOCH)),)
export SOURCE_DATE_EPOCH
else
unexport SOURCE_DATE_EPOCH
endif
always-y += buildtag.h
$(addprefix $(obj)/,$(mars-objs)): $(obj)/buildtag.h
ifneq ($(KBUILD_EXTMOD),)
$(addprefix $(obj)/,$(mars-objs)): $(obj)/mars_config.h
endif
$(obj)/buildtag.h: $(src)/../scripts/gen_buildtag.pl FORCE
	$(Q)$(kecho) "  GEN     $@"
	$(Q)set -e; trap 'rm -f "$@.tmp"' EXIT; \
	    perl $(src)/../scripts/gen_buildtag.pl $(src) '$(KERNELRELEASE)' > $@.tmp; \
	    if ! cmp -s $@.tmp $@; then mv $@.tmp $@; fi

clean-files += mars_config.h buildtag.h
